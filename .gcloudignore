# Files uploaded by 'gcloud builds submit' — same exclusions as the Docker build
.gcloudignore
# Never ship secrets or local data in the image
**/.env
**/.env.*
!**/.env.example
**/*-key.json
**/gcp-key.json
**/*.db
**/*.db.bak
**/*.db-journal

# Build output / dependencies (rebuilt inside the image)
**/node_modules
frontend/build
**/__pycache__
**/*.pyc
**/.venv
**/venv

# Tooling
.git
.idea
.vscode
