# Copy this to .env and fill in your values

# App
APP_NAME="Family AI Assistant"
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production

# Database — SQLite for dev, swap URL for PostgreSQL in prod
# SQLite:
DATABASE_URL=sqlite+aiosqlite:///./family_aid.db
# PostgreSQL (uncomment to migrate):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/family_aid

# Groq Free API — get key at console.groq.com (free, no credit card)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback

# CORS
FRONTEND_URL=http://localhost:3000
