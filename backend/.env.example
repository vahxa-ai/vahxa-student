# Copy this to .env and fill in your values

# App
APP_NAME="Student AI Assistant"
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production

# Database — SQLite for dev, swap URL for PostgreSQL in prod
# SQLite:
DATABASE_URL=sqlite+aiosqlite:///./student_aid.db
# PostgreSQL (uncomment to migrate):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/student_aid

# Vertex AI — Gemma 4 (serverless). Authenticate with:
#   gcloud auth application-default login
# or set GOOGLE_CREDENTIALS_FILE to a service-account key (role: Vertex AI User).
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODEL=google/gemma-4-26b-a4b-it-maas
# GOOGLE_CREDENTIALS_FILE=gcp-key.json

# Shared curriculum library (Firestore, same project) — curricula are reused across
# students with the same subject + grade + state + country. Needs role: Cloud Datastore User.
CURRICULUM_LIBRARY_ENABLED=true
FIRESTORE_DATABASE=(default)
CURRICULUM_LIBRARY_COLLECTION=curriculum_library

# Accounts — Sign in with Google (Web OAuth client ID; add your app URL as an Authorized JavaScript origin)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Long random string that signs session cookies (keep secret)
SESSION_SECRET=change-me
ADMIN_EMAILS=admin@example.com
# Public URL used in emailed links
APP_BASE_URL=http://localhost:3000

# Email (parental consent requests, approval notices) — Gmail with an App Password
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# CORS
FRONTEND_URL=http://localhost:3000
